// Subscription records: users/{uid}/userSubscriptions/current only.
// Amount is positive; dates use the app's existing ISO string format.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validSubscription(data) {
      return data.keys().hasAll(['kind', 'amount', 'currency', 'durationMonths',
          'status', 'paymentDate', 'startDate', 'endDate', 'renewals', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['kind', 'amount', 'currency', 'durationMonths',
          'status', 'paymentDate', 'startDate', 'endDate', 'renewals', 'createdAt', 'updatedAt'])
        && data.kind == 'gym'
        && data.amount is number && data.amount > 0
        && data.currency in ['NPR', 'INR', 'USD', 'EUR', 'GBP', 'AUD', 'CAD', 'JPY', 'AED']
        && data.durationMonths in [1, 3, 6, 12]
        && data.status == 'active'
        && validSubscriptionDate(data.paymentDate)
        && validSubscriptionDate(data.startDate)
        && validSubscriptionDate(data.endDate)
        && data.endDate > data.startDate
        && validSubscriptionDate(data.createdAt)
        && validSubscriptionDate(data.updatedAt)
        && data.renewals is list && data.renewals.size() <= 1000;
    }

    function validSubscriptionDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /userSubscriptions/current {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validSubscription(request.resource.data);
        allow update: if isOwner(userId) && validSubscription(request.resource.data)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if false;
      }

      match /exerciseRecords/{recordId} {
        allow read, write: if isOwner(userId);
      }

      match /measurementRecords/{recordId} {
        allow read, write: if isOwner(userId);
      }

      match /prRecords/{recordId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /sharedSchedules/{scheduleId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.sharedBy == request.auth.uid
        && request.resource.data.exercises is list
        && request.resource.data.exercises.size() > 0
        && request.resource.data.exercises.size() <= 200;
      allow update, delete: if false;
    }
  }
}
