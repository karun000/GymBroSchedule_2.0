rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /exerciseRecords/{recordId} {
        allow read, write: if isOwner(userId);
      }

      match /measurementRecords/{recordId} {
        allow read, write: if isOwner(userId);
      }

      match /prRecords/{recordId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /sharedSchedules/{scheduleId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.sharedBy == request.auth.uid
        && request.resource.data.exercises is list
        && request.resource.data.exercises.size() > 0
        && request.resource.data.exercises.size() <= 200;
      allow update, delete: if false;
    }
  }
}
